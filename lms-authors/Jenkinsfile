pipeline {
    agent any

    environment {
        MAVEN_HOME = '/usr/share/maven'
        PATH = "$PATH:$MAVEN_HOME/bin"

        GIT_REPO_URL = 'https://github.com/1201198luissilva/psoft-project-2025-26-m1d-lm.git'
        GIT_BRANCH = 'main'
        CREDENTIALS_ID = 'github-token'

        SERVICE_NAME = 'lms-authors'
        IMAGE_NAME = 'lmsauthors'
        IMAGE_TAG = 'latest'
        SERVER_PORT = '8090'
        
        RECIPIENT_EMAIL = 'ljsilva.2002@gmail.com'
        NETWORK_NAME = 'lms_network'
    }

    stages {

        stage('Debug Environment') {
            steps {
                echo 'Exibindo variáveis de ambiente...'
                sh 'printenv'
            }
        }

        stage('Check Docker') {
            steps {
                echo 'Verificando Docker...'
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Checkout') {
            steps {
                echo 'Clonando código do repositório...'
                checkout([$class: 'GitSCM', 
                          branches: [[name: "${GIT_BRANCH}"]], 
                          userRemoteConfigs: [[url: "${GIT_REPO_URL}", credentialsId: "${CREDENTIALS_ID}"]]])
            }
        }

        stage('Validate') {
            steps {
                echo 'Validando estrutura do projeto...'
                sh """
                    if [ ! -d "${SERVICE_NAME}" ]; then
                        echo "Erro: Diretório ${SERVICE_NAME} não encontrado"
                        exit 1
                    fi
                    if [ ! -f "${SERVICE_NAME}/pom.xml" ]; then
                        echo "Erro: pom.xml não encontrado em ${SERVICE_NAME}"
                        exit 1
                    fi
                    echo "Validação concluída com sucesso"
                """
            }
        }

        stage('Clean') {
            steps {
                echo 'Limpando projeto...'
                dir("${SERVICE_NAME}") {
                    sh 'mvn clean'
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Compilando e empacotando projeto...'
                dir("${SERVICE_NAME}") {
                    sh 'mvn package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${SERVICE_NAME}/target/*.jar", fingerprint: true
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Executando testes unitários...'
                dir("${SERVICE_NAME}") {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit "${SERVICE_NAME}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Construindo imagem Docker ${IMAGE_NAME}:${IMAGE_TAG}..."
                dir("${SERVICE_NAME}") {
                    sh """
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker images | grep ${IMAGE_NAME}
                    """
                }
            }
        }

        stage('Create Docker Network') {
            steps {
                echo "Verificando e criando rede Docker ${NETWORK_NAME}..."
                script {
                    sh """
                        # Verificar se a rede existe
                        if ! docker network inspect ${NETWORK_NAME} > /dev/null 2>&1; then
                            echo "Criando rede bridge para Docker Compose..."
                            docker network create ${NETWORK_NAME}
                        else
                            echo "Rede ${NETWORK_NAME} já existe"
                        fi
                        
                        # Verificar configuração da rede
                        docker network inspect ${NETWORK_NAME}
                    """
                }
            }
        }

        stage('Start RabbitMQ') {
            steps {
                echo 'Iniciando RabbitMQ...'
                script {
                    sh """
                        # Verificar e iniciar RabbitMQ
                        if ! docker ps -q -f name=rabbitmq_in_lms_network > /dev/null 2>&1; then
                            echo "Iniciando container RabbitMQ..."
                            docker run -d --name rabbitmq_in_lms_network \\
                                -p 5672:5672 -p 15672:15672 \\
                                --network ${NETWORK_NAME} \\
                                rabbitmq:management
                            sleep 10
                        else
                            echo "RabbitMQ já está em execução"
                            # Conectar à rede se necessário
                            if ! docker network inspect ${NETWORK_NAME} -f '{{json .Containers}}' | grep -q 'rabbitmq_in_lms_network'; then
                                echo "Conectando RabbitMQ à rede..."
                                docker network connect ${NETWORK_NAME} rabbitmq_in_lms_network
                            fi
                        fi
                        
                        # Verificar status
                        docker ps | grep rabbitmq
                    """
                }
            }
        }

        stage('Notify User for Approval') {
            steps {
                echo 'Enviando notificação de aprovação...'
                emailext (
                    subject: "${SERVICE_NAME} Jenkins Pipeline - Deployment Ready",
                    body: """A pipeline do ${SERVICE_NAME} foi executada com sucesso e está pronta para deploy.
                        
                        Aprovação necessária em: ${BUILD_URL}input/
                        
                        Serviço: ${SERVICE_NAME}
                        Imagem: ${IMAGE_NAME}:${IMAGE_TAG}""",
                    to: "${RECIPIENT_EMAIL}"
                )
            }
        }

        stage('Wait for Approval') {
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        echo "Aguardando aprovação do usuário..."
                        def userInput = input(
                            message: "Deseja prosseguir com o deployment do ${SERVICE_NAME}?",
                            parameters: [
                                choice(name: 'Approve Deployment', 
                                       choices: ['Yes', 'No'], 
                                       description: 'Selecione Yes para continuar ou No para cancelar.')
                            ]
                        )
                        if (userInput == 'No') {
                            currentBuild.result = 'ABORTED'
                            error("Deployment cancelado pelo usuário.")
                        }
                    }
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                echo 'Executando deployment com Docker Compose...'
                dir("${SERVICE_NAME}") {
                    sh """
                        if [ -f docker-compose.yml ]; then
                            # Backup da versão atual (se existir)
                            echo "=== BACKUP DA VERSÃO ANTERIOR ==="
                            if docker images | grep -q "${IMAGE_NAME}:${IMAGE_TAG}"; then
                                docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:rollback || true
                                echo "Backup criado: ${IMAGE_NAME}:rollback"
                            else
                                echo "Nenhuma versão anterior encontrada para backup"
                            fi
                            
                            # Parar containers antigos
                            docker-compose down || true
                            
                            # Iniciar nova versão
                            echo "=== DEPLOYMENT DA NOVA VERSÃO ==="
                            docker-compose up -d --build
                            
                            # Aguardar serviços iniciarem
                            echo "Aguardando inicialização dos serviços..."
                            sleep 45
                            
                            # Health Check
                            echo "=== EXECUTANDO HEALTH CHECK ==="
                            HEALTH_CHECK_FAILED=0
                            
                            # Testar instância 1 (porta 9001)
                            if curl -f -s -o /dev/null -w "%{http_code}" http://localhost:9001/actuator/health | grep -q "200"; then
                                echo "✓ Instância 1 (porta 9001) - SAUDÁVEL"
                            else
                                echo "✗ Instância 1 (porta 9001) - FALHA NO HEALTH CHECK"
                                HEALTH_CHECK_FAILED=1
                            fi
                            
                            # Testar instância 2 (porta 9002) se existir
                            if docker-compose ps | grep -q "authors2_in_lms_network"; then
                                if curl -f -s -o /dev/null -w "%{http_code}" http://localhost:9002/actuator/health | grep -q "200"; then
                                    echo "✓ Instância 2 (porta 9002) - SAUDÁVEL"
                                else
                                    echo "✗ Instância 2 (porta 9002) - FALHA NO HEALTH CHECK"
                                    HEALTH_CHECK_FAILED=1
                                fi
                            fi
                            
                            # Rollback se health check falhou
                            if [ \$HEALTH_CHECK_FAILED -eq 1 ]; then
                                echo "=== INICIANDO ROLLBACK AUTOMÁTICO ==="
                                
                                if docker images | grep -q "${IMAGE_NAME}:rollback"; then
                                    echo "Parando versão com falha..."
                                    docker-compose down
                                    
                                    echo "Restaurando versão anterior..."
                                    docker tag ${IMAGE_NAME}:rollback ${IMAGE_NAME}:${IMAGE_TAG}
                                    
                                    echo "Reiniciando com versão anterior..."
                                    docker-compose up -d
                                    sleep 10
                                    
                                    echo "=== ROLLBACK CONCLUÍDO ==="
                                    echo "Serviço foi revertido para a versão anterior"
                                    
                                    # Verificar se rollback funcionou
                                    if curl -f -s -o /dev/null http://localhost:9001/actuator/health; then
                                        echo "✓ Versão anterior está funcionando corretamente"
                                    else
                                        echo "✗ ALERTA: Versão anterior também apresentou problemas"
                                    fi
                                    
                                    exit 1
                                else
                                    echo "✗ Nenhuma versão anterior disponível para rollback"
                                    docker-compose down
                                    exit 1
                                fi
                            else
                                echo "=== DEPLOYMENT CONCLUÍDO COM SUCESSO ==="
                                docker-compose ps
                            fi
                        else
                            echo "Erro: docker-compose.yml não encontrado"
                            exit 1
                        fi
                    """
                }
            }
        }

        stage('Scale Services') {
            steps {
                script {
                    def scaleCount = input(
                        message: 'Quantas instâncias deseja executar?',
                        parameters: [
                            choice(name: 'COUNT', 
                                   choices: ['1', '2'], 
                                   description: 'Número de instâncias (1 ou 2 conforme docker-compose.yml)')
                        ]
                    )

                    echo "Configurando para ${scaleCount} instâncias..."
                    dir("${SERVICE_NAME}") {
                        sh """
                            if [ "${scaleCount}" = "1" ]; then
                                docker-compose up -d lmauthors_1
                                docker-compose stop lmsauthors_2 || true
                            else
                                docker-compose up -d lmauthors_1 lmsauthors_2
                            fi
                            docker-compose ps
                        """
                    }
                }
            }
        }

        stage('Shutdown Services') {
            steps {
                echo 'Desligando serviços com Docker Compose...'
                dir("${SERVICE_NAME}") {
                    sh """
                        if [ -f docker-compose.yml ]; then
                            docker-compose down
                            echo "Serviços desligados com sucesso"
                        else
                            echo "Aviso: docker-compose.yml não encontrado"
                        fi
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✓ Pipeline ${SERVICE_NAME} concluída com sucesso!"
            emailext (
                subject: "✓ ${SERVICE_NAME} Deployed Successfully - Automatic message",
                body: """
                    Olá,

                    O serviço ${SERVICE_NAME} foi deployado com sucesso.

                    Imagem: ${IMAGE_NAME}:${IMAGE_TAG}
                    Porta: ${SERVER_PORT}
                    Build: ${BUILD_URL}

                    Atenciosamente,
                    Jenkins
                """,
                to: "${RECIPIENT_EMAIL}",
                from: "${RECIPIENT_EMAIL}"
            )
        }
        failure {
            echo "✗ Pipeline ${SERVICE_NAME} falhou!"
            emailext (
                subject: "✗ ${SERVICE_NAME} Pipeline Failed - Automatic message",
                body: """
                    Olá,

                    A execução da pipeline do ${SERVICE_NAME} falhou.

                    Por favor, verifique os logs em: ${BUILD_URL}console

                    Serviço: ${SERVICE_NAME}
                    
                    Atenciosamente,
                    Jenkins
                """,
                to: "${RECIPIENT_EMAIL}",
                from: "${RECIPIENT_EMAIL}"
            )
        }
        always {
            echo 'Pipeline finalizada'
        }
    }
}
